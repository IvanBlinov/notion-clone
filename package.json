{
  "name": "notion-clone",
  "version": "1.0.0",
  "description": "A Notion-style workspace (GitHub Pages + Convex) with an MCP server so AI agents can create and edit pages",
  "scripts": {
    "dev": "node scripts/build-web.js && node scripts/serve.js",
